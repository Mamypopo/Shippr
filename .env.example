# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
#
# Supabase is used only as a Postgres host — authentication is handled by the
# app itself, so there is no Supabase API key to configure.
# ---------------------------------------------------------------------------

# Transaction pooler (port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler or direct connection (port 5432) — used by `prisma migrate`.
# DDL cannot run through the pgbouncer endpoint.
#
# Prefer the **Session pooler** unless the network has working IPv6: the
# direct `db.<ref>.supabase.co` host is IPv6-only and will fail with P1001 on
# an IPv4-only connection.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# A password containing reserved URL characters must be percent-encoded, or
# everything after the character is silently dropped:
#   node -e "console.log(encodeURIComponent('your#password'))"

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret the ingestion routes require. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="<random-32-byte-hex>"
