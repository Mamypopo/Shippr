// Logistics Market Intelligence & AHP Carrier Decision Dashboard
// Prisma 7 + PostgreSQL (Supabase). Connection URL lives in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IndexCode {
  WCI // Drewry World Container Index
  SCFI // Shanghai Containerized Freight Index
  BDRY // Breakwave Dry Bulk Shipping ETF
  WTI // WTI crude oil futures — proxy for bunker fuel cost
  BRENT // Brent crude oil futures — proxy for bunker fuel cost
  ZIM // ZIM Integrated Shipping Services — carrier stock, sentiment proxy
  VLSFO // Very Low Sulphur Fuel Oil — the actual bunker fuel carriers burn, not a proxy
}

enum IndexUnit {
  USD_PER_FEU
  POINTS
  USD
  USD_PER_MT // Bunker fuel is quoted per metric ton, not per container or per share.
}

/// Where a data point came from. Shown in the UI so a reader can tell a
/// scraped figure from one a human typed in.
enum DataSource {
  SCRAPER
  MANUAL
  YAHOO
  CSV_IMPORT
}

enum RiskLevel {
  LOW // < 2 days
  MODERATE // 2-4 days
  HIGH // > 4 days
}

enum DisruptionTag {
  GEOPOLITICS
  LABOR
  CHOKEPOINT
  WEATHER
  CAPACITY
  RATE_MOVE
}

enum NewsSeverity {
  INFO
  WATCH
  ALERT
}

enum RunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum UserRole {
  VIEWER
  ANALYST
  ADMIN
}

// ---------------------------------------------------------------------------
// Module 1 - Freight rate benchmarking
// ---------------------------------------------------------------------------

/// One observation of one index on one route for one period.
/// WoW / MoM / moving averages are NOT stored: they are derived in
/// `lib/metrics.ts` so a corrected back-value cannot leave stale deltas behind.
model FreightIndex {
  id          String     @id @default(cuid())
  indexCode   IndexCode
  /// Lane identifier, e.g. COMPOSITE, SHA_RTM, SHA_LAX. Free-form so new
  /// lanes do not require a migration.
  routeCode   String     @default("COMPOSITE")
  /// The date the index itself refers to, not the time we fetched it.
  periodDate  DateTime   @db.Date
  value       Decimal    @db.Decimal(12, 2)
  unit        IndexUnit
  source      DataSource
  enteredById String?
  /// Raw payload kept for forensics when a parse later turns out wrong.
  rawSnapshot Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  enteredBy UserProfile? @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([indexCode, routeCode, periodDate])
  @@index([indexCode, periodDate(sort: Desc)])
  @@map("freight_index")
}

// ---------------------------------------------------------------------------
// Module 2 - Port congestion & disruption
// ---------------------------------------------------------------------------

model Port {
  id        String  @id @default(cuid())
  /// UN/LOCODE, e.g. THLCH for Laem Chabang.
  unlocode  String  @unique
  name      String
  country   String
  lat       Float?
  lon       Float?
  /// Controls dashboard ordering; lower sorts first.
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  statuses       PortStatus[]
  trackedVessels TrackedVessel[]

  @@map("port")
}

model PortStatus {
  id             String     @id @default(cuid())
  portId         String
  observedOn     DateTime   @db.Date
  /// 7-day average vessel waiting time in days.
  avgWaitDays    Decimal    @db.Decimal(4, 2)
  vesselsWaiting Int?
  /// Persisted so a historical row keeps the banding it was judged under,
  /// even if the thresholds are later retuned.
  riskLevel      RiskLevel
  source         DataSource
  note           String?
  enteredById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  port      Port         @relation(fields: [portId], references: [id], onDelete: Cascade)
  enteredBy UserProfile? @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([portId, observedOn])
  @@index([observedOn(sort: Desc)])
  @@map("port_status")
}

model NewsFeedItem {
  id              String          @id @default(cuid())
  /// RSS guid, or a hash of the link when the feed omits one. The dedupe key.
  guid            String          @unique
  sourceName      String
  title           String
  link            String
  summary         String?
  publishedAt     DateTime
  tags            DisruptionTag[]
  severity        NewsSeverity    @default(INFO)
  matchedKeywords String[]
  createdAt       DateTime        @default(now())

  @@index([publishedAt(sort: Desc)])
  @@index([severity])
  @@map("news_feed_item")
}

// ---------------------------------------------------------------------------
// Module 3 - AHP carrier decision
// ---------------------------------------------------------------------------

model CarrierQuote {
  id          String  @id @default(cuid())
  decisionId  String?
  carrierName String
  serviceName String?

  // Cost inputs (USD). effectiveCost is derived in lib/cost.ts.
  oceanFreightUsd        Decimal @db.Decimal(12, 2)
  localChargesUsd        Decimal @default(0) @db.Decimal(12, 2)
  freeTimeDays           Int     @default(0)
  freeTimeValuePerDayUsd Decimal @default(0) @db.Decimal(10, 2)

  // Transit
  transitDays        Int
  isDirect           Boolean @default(true)
  transshipmentCount Int     @default(0)

  // Reliability
  onTimePct               Decimal @db.Decimal(5, 2)
  blankSailingsPerQuarter Int     @default(0)

  // Space & equipment
  equipmentAvailabilityScore Int @default(5) // 1-10
  bookingSlaHours            Int @default(24)

  // Service & documentation
  docTurnaroundHours Int @default(24)
  serviceScore       Int @default(5) // 1-10

  containerType String    @default("40HC")
  validUntil    DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  decision AHPDecisionLog? @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("carrier_quote")
}

/// The auditable record of one carrier selection.
model AHPDecisionLog {
  id        String  @id @default(cuid())
  userId    String?
  title     String
  presetKey String?

  originLocode String?
  destLocode   String?
  /// Lane used to pick the market benchmark, e.g. SHA_RTM.
  routeCode    String?

  /// Human-facing case reference, e.g. "FF-001". Auto-generated at save time
  /// when left blank — there is no central shipment system this maps to, so
  /// it is just a sequential label, not a foreign key into anything.
  caseId           String?
  /// e.g. "40HC" — the container type being shipped, distinct from a quote's
  /// own containerType (which is what that specific carrier quoted for).
  equipment        String?
  cargoDescription String?
  quantity         Int?
  requiredEtd      DateTime? @db.Date
  /// Free-text market-condition label (e.g. "PEAK_SEASON") attached to the
  /// case for context only — deliberately never read by the AHP weighting.
  scenario         String?

  /// Raw n x n Saaty matrix exactly as the user entered it.
  criteriaMatrix    Json
  /// Criterion key -> weight.
  criteriaWeights   Json
  lambdaMax         Float
  consistencyIndex  Float
  consistencyRatio  Float
  isConsistent      Boolean
  /// Per-carrier per-criterion local scores plus the final 0-100 score.
  alternativeScores Json
  winnerCarrier     String

  /// Market figures frozen at decision time. A memo read six weeks later must
  /// show the market as it was on the day of the call, not as it is now.
  benchmarkSnapshot Json?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotes CarrierQuote[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("ahp_decision_log")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// One row per ingestion attempt. Lets the dashboard say "Drewry: last
/// success 3 days ago" instead of silently showing an old number as current.
model ScrapeRun {
  id           String    @id @default(cuid())
  source       String
  status       RunStatus
  rowsWritten  Int       @default(0)
  errorMessage String?
  durationMs   Int
  startedAt    DateTime  @default(now())

  @@index([source, startedAt(sort: Desc)])
  @@map("scrape_run")
}

/// A specific vessel worth watching because an actual shipment is on it, not
/// a generic regional view (that's `LiveShipMap`). One row per vessel being
/// tracked right now; `isActive` turns tracking off without losing the
/// position history once a shipment has arrived.
model TrackedVessel {
  id                String   @id @default(cuid())
  /// Maritime Mobile Service Identity — the number AIS position reports are
  /// keyed by, not the vessel's name (names collide; MMSIs don't).
  mmsi              Int      @unique
  /// Free text, e.g. "ตู้ส่งลูกค้า ABC — PO 1234" — a worklist label, not a vessel registry entry.
  label             String
  destinationPortId String?
  isActive          Boolean  @default(true)
  enteredById       String?
  createdAt         DateTime @default(now())

  destinationPort Port?            @relation(fields: [destinationPortId], references: [id], onDelete: SetNull)
  enteredBy       UserProfile?     @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  positions       VesselPosition[]

  @@map("tracked_vessel")
}

/// One AIS position report. Kept as history, not overwritten in place, so a
/// vessel's recent track can be shown later even though only the latest
/// reading is used today.
model VesselPosition {
  id         String   @id @default(cuid())
  vesselId   String
  observedAt DateTime
  lat        Float
  lon        Float
  speedKnots Float?
  /// True heading in degrees, when the AIS message included one.
  courseDeg  Float?
  /// AIS navigational status text as reported, e.g. "Under way using engine".
  navStatus  String?
  createdAt  DateTime @default(now())

  vessel TrackedVessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@unique([vesselId, observedAt])
  @@index([vesselId, observedAt(sort: Desc)])
  @@map("vessel_position")
}

/// A booking actually placed with a carrier. Records the real timeline so the
/// AHP comparison can use measured confirmation speed and on-time rate, not
/// guesses typed in from memory.
model CarrierBooking {
  id              String    @id @default(cuid())
  /// Matched case-insensitively against the carrier name typed into a quote.
  carrierName     String
  bookedOn        DateTime  @db.Date
  /// When the carrier confirmed the booking. Null while still waiting.
  confirmedAt     DateTime?
  /// Agreed arrival date at the destination port.
  expectedArrival DateTime? @db.Date
  /// Actual arrival date. Null until the vessel has arrived.
  arrivedAt       DateTime? @db.Date
  enteredById     String?
  createdAt       DateTime  @default(now())

  enteredBy UserProfile? @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([carrierName])
  @@map("carrier_booking")
}

model UserProfile {
  id           String   @id @default(cuid())
  /// Lowercase, unique. The only thing a user types to identify themselves.
  username     String   @unique
  /// scrypt, stored as `scrypt$N$r$p$salt$hash`. See lib/password.ts.
  passwordHash String
  fullName     String?
  orgName      String?
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)

  /// Brute-force throttling. Reset to zero on a successful sign-in.
  failedAttempts Int       @default(0)
  /// Set when failedAttempts crosses the limit; sign-in refuses until it passes.
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  decisions       AHPDecisionLog[]
  freightEntries  FreightIndex[]
  portEntries     PortStatus[]
  trackedVessels  TrackedVessel[]
  carrierBookings CarrierBooking[]

  @@map("user_profile")
}

/// A signed-in browser.
///
/// Only the SHA-256 of the cookie token is stored: a leaked database dump
/// cannot then be replayed as a live session. Sessions are rows rather than
/// self-signed tokens so that revoking one actually revokes it.
model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the token held in the cookie. Never the token itself.
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Rolling renewal, so an active user is not signed out mid-week.
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}
